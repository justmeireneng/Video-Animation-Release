# ==============================================================================
# Video Animation - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file with production keys to version control!
# ==============================================================================

# LLM Script & Storyboard Provider (Google Gemini / OpenAI / Anthropic)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Image & Video Cloud Providers
GOOGLE_FLOW_ACCESS_TOKEN=
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
COMFYUI_SERVER_URL=http://127.0.0.1:8188

# Voice Narration (OmniVoice / EdgeTTS)
OMNIVOICE_MODEL_ID=k2-fsa/OmniVoice
OMNIVOICE_DEVICE=cpu
EDGE_TTS_VOICE=vi-VN-NamMinhNeural

# System Tools
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
